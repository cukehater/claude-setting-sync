{
  "env": {
    "EDITOR": "code --wait"
  },
  "attribution": {
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\Gravity\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "figma@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "eli5@claude-community": true,
    "humanize-korean@im-not-ai": true,
    "postman@claude-plugins-official": true,
    "impeccable@claude-community": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "im-not-ai": {
      "source": {
        "source": "github",
        "repo": "epoko77-ai/im-not-ai"
      }
    }
  },
  "language": "Korean",
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
